# BMAD — per-user installer answers.
# Regenerated on every install; holds personal values (user name, language).
# Team-shared config lives in _bmad/config.toml and _bmad/custom/config.toml.
_bmad/config.user.toml

# Token Savior local cache (per-machine index metadata).
.token-savior-cache.json

# Android / Gradle build output.
.gradle/
**/build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Spike A harness (tools/spike-a) — throwaway build output only. The harness is
# standalone, not a Gradle module; its local SDK path stays machine-local.
tools/spike-a/.gradle/
tools/spike-a/.kotlin/
tools/spike-a/build/
tools/spike-a/local.properties
tools/spike-a/app/build/

# Machine-local SDK path. Never shared: it names one developer's disk layout.
local.properties

# Signing and pairing material. Policy: never committed.
# Pairing material at runtime lives in Keystore, not in the repo.
keystore.properties
*.jks
*.keystore
*.p12
*.pfx
*.pepk

# IDE state.
.idea/
*.iml

# OS clutter.
.DS_Store
Thumbs.db

# Build artifacts that are never inputs.
*.apk
*.aab
*.ap_
*.dex

# Exception: the Spike A sideloadable is published here deliberately.
!debug/*.apk
