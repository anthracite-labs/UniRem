<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: allowBackup is false in the manifest, and every domain is
     excluded here so no token, pin, SPKI, or preference can ride a backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
