<?xml version="1.0" encoding="utf-8"?>
<!-- Device-to-device transfer exclusion mirrors backup_rules.xml: pairing
     ciphertext and the TV-record database never transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="unirem_pairing.xml" />
        <exclude domain="database" path="unirem-tvs" />
        <exclude domain="database" path="unirem-tvs-wal" />
        <exclude domain="database" path="unirem-tvs-shm" />
        <exclude domain="database" path="unirem-tvs-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="unirem_pairing.xml" />
        <exclude domain="database" path="unirem-tvs" />
        <exclude domain="database" path="unirem-tvs-wal" />
        <exclude domain="database" path="unirem-tvs-shm" />
        <exclude domain="database" path="unirem-tvs-journal" />
    </device-transfer>
</data-extraction-rules>
