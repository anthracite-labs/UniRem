# Normalize text to LF in the repository and in the working tree.
# Firmware strings and matrix keys are compared byte-exactly, so line endings
# must never differ between a developer's checkout and CI.
* text=auto eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.aar binary
*.jks binary
*.keystore binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
